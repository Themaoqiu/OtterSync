rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: request is from an authenticated user
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper: document belongs to the current user
    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    // Helper: request document has required string fields
    function hasRequiredStrings(fields) {
      return request.resource.data.keys().hasAll(fields)
        && fields.every(f, request.resource.data[f] is string && request.resource.data[f].size() > 0);
    }

    // _meta: authenticated users can read, only server/admin can write
    match /_meta/{doc} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // users: authenticated users can read all, only write their own
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isOwner(uid)
        && hasRequiredStrings(['uid', 'username', 'email'])
        && request.resource.data['uid'] == request.auth.uid;
      allow update: if isSignedIn() && isOwner(uid);
      allow delete: if isSignedIn() && isOwner(uid);
    }

    // Shared resources: workspaces, workTypes, teams, labels
    // All authenticated users can read and write (collaboration model)
    match /workspaces/{doc} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && hasRequiredStrings(['title', 'subtitle']);
      allow update, delete: if isSignedIn();
    }

    match /workTypes/{doc} {
      allow read, write: if isSignedIn();
    }

    match /teams/{doc} {
      allow read, write: if isSignedIn();
    }

    match /labels/{doc} {
      allow read, write: if isSignedIn();
    }

    // Work items: authenticated users have full access (team collaboration)
    match /workItems/{doc} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && hasRequiredStrings(['summary', 'key'])
        && request.resource.data['createdBy'] == request.auth.uid;
      allow update, delete: if isSignedIn();
    }

    // Feedback: users can read all, create their own, delete their own
    match /feedback/{doc} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.type in ['like', 'dislike'];
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // Recent views: users manage their own records
    match /recentViews/{id} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn();
    }
  }
}
