rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: request is from an authenticated user
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper: document belongs to the current user
    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    // _meta: authenticated users can read, only server/admin can write
    match /_meta/{doc} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // users: authenticated users can read all, only write their own
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isOwner(uid);
      allow update, delete: if isSignedIn() && isOwner(uid);
    }

    // Shared resources: workspaces, workTypes, teams, labels
    // All authenticated users can read and write (collaboration model)
    match /workspaces/{doc} {
      allow read, write: if isSignedIn();
    }

    match /workTypes/{doc} {
      allow read, write: if isSignedIn();
    }

    match /teams/{doc} {
      allow read, write: if isSignedIn();
    }

    match /labels/{doc} {
      allow read, write: if isSignedIn();
    }

    // Work items: authenticated users have full access (team collaboration)
    match /workItems/{doc} {
      allow read, write: if isSignedIn();
    }
  }
}